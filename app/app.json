{
  "expo": {
    "name": "סורק פירות",
    "slug": "produce-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sharonekub.producescanner",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#186E44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sharonekub.producescanner",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "האפליקציה משתמשת במצלמה כדי לצלם את הפרי לצורך הערכה חזותית. התמונות מעובדות במכשיר.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה פותחת את הגלריה רק כשבוחרים תמונה של פרי לבדיקה.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "producescanner",
    "extra": {
      "supportsRTL": true,
      "inference": {
        "mode": "native",
        "serverUrl": "https://sharonekub-svg-produce-scanner-il.vercel.app"
      },
      "feedback": {
        "url": "https://ucaahtdudyicliqwpvcu.supabase.co",
        "anonKey": "sb_publishable__v13t2xj7oECaVCNfIiVMw_E-af0P8k"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
