      "adapter": "path_rules",
      "verified_against_download": true,
      "verified_note": "Layout checked 2026-09-27: 'Good and bad classification of apple/{Good ,Bad}/<name>[-XXXXXX].jpg'; -XXXXXX suffixes are augmented copies of one photo (grouped). Visual audit: Bad = bruises, dark rot, cracks.",
      "default_produce": "apple",
      "group_pattern": "/(?P<group>[^/]+?)(-[A-Za-z0-9]{6})?\\.(jpe?g|png)$",
      "rules": [
        {
          "pattern": "/Good ?/",
          "labels": {
            "freshness": "fresh",
            "visual_spoilage": "none"
          }
        },
        {
          "pattern": "/Bad/",
          "labels": {
            "freshness": [
              "declining",
