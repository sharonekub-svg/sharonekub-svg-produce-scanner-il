  "label_he": {
    "ripeness":        {"unripe": "לא בשל", "partially_ripe": "כמעט בשל", "ripe": "בשל", "overripe": "בשל מדי", "unknown": "לא ידוע"},
    "freshness":       {"fresh": "טרי", "declining": "פחות טרי", "spoiled": "מקולקל", "unknown": "לא ידוע"},
    "visual_spoilage": {"none": "לא זוהו", "mild": "סימנים קלים", "severe": "סימנים משמעותיים", "unknown": "לא ידוע"}
  },
  "datasets": {
    "own_il_collection": {
      "adapter": "table",
      "verified_against_download": true,
      "table": "labels.csv",
      "path_column": "path",
      "group_column": "fruit_instance_id",
      "columns":                   {"produce": "produce", "ripeness": "ripeness", "freshness": "freshness", "visual_spoilage": "visual_spoilage"},
      "value_maps":                {}
    },
    "grocery_store_klasson": {
      "adapter": "path_rules",
      "verified_against_download": true,
      "verified_note": "Layout checked 2026-09-26 at git commit in .provenance.json: dataset/{train,val,test}/{Fruit,Vegetables,Packages}/<Coarse>[/<Fine>]/<Fine>_NNN.jpg, 348x348",
      "exclude_patterns": ["iconic-images", "(^|/)Packages/", "(^|/)sample_images/"],
      "split_pattern": "(^|/)dataset/(?P<split>train|val|test)/",
      "rules": [
        {"pattern": "(^|/)Watermelon(/|$)", "labels": {"produce": "watermelon"}},
        {"pattern": "(^|/)(Cantaloupe|Galia-Melon|Honeydew-Melon)(/|$)", "labels": {"produce": "melon"}},
        {"pattern": "(^|/)Apple(/|$)", "labels": {"produce": "apple"}},
        {"pattern": "(^|/)Avocado(/|$)", "labels": {"produce": "avocado"}},
        {"pattern": "(^|/)Banana(/|$)", "labels": {"produce": "banana"}},
        {"pattern": "(^|/)Kiwi(/|$)", "labels": {"produce": "kiwi"}},
        {"pattern": "(^|/)Lemon(/|$)", "labels": {"produce": "lemon"}},
        {"pattern": "(^|/)Mango(/|$)", "labels": {"produce": "mango"}},
        {"pattern": "(^|/)Nectarine(/|$)", "labels": {"produce": "nectarine"}},
        {"pattern": "(^|/)Satsumas(/|$)", "labels": {"produce": "mandarin"}},
        {"pattern": "(^|/)Orange(/|$)", "labels": {"produce": "orange"}},
        {"pattern": "(^|/)Peach(/|$)", "labels": {"produce": "peach"}},
        {"pattern": "(^|/)Pear(/|$)", "labels": {"produce": "pear"}},
        {"pattern": "(^|/)Plum(/|$)", "labels": {"produce": "plum"}},
        {"pattern": "(^|/)Pomegranate(/|$)", "labels": {"produce": "pomegranate"}},
        {"pattern": "(^|/)Cucumber(/|$)", "labels": {"produce": "cucumber"}},
        {"pattern": "(^|/)Tomato(/|$)", "labels": {"produce": "tomato"}},
        {"pattern": "(^|/)Pepper(/|$)", "labels": {"produce": "pepper"}},
        {"pattern": "(^|/)Lime(/|$)", "labels": {"produce": "lime"}},
        {"pattern": "(^|/)Red-Grapefruit(/|$)", "labels": {"produce": "grapefruit"}},
        {"pattern": "(^|/)Zucchini(/|$)", "labels": {"produce": "zucchini"}},
        {"pattern": "(^|/)Potato(/|$)", "labels": {"produce": "potato"}},
        {"pattern": "(^|/)Passion-Fruit(/|$)", "labels": {"produce": "passion_fruit"}},
        {"pattern": "(^|/)(Fruit|Vegetables)/", "labels": {"produce": "other"}}
      ]
    },
    "fruitnet_indian": {
      "adapter": "path_rules",
      "verified_against_download": false,
      "exclude_patterns": ["(?i)mixed"],
      "rules": [
        {"pattern": "(?i)apple", "labels": {"produce": "apple"}},
        {"pattern": "(?i)banana", "labels": {"produce": "banana"}},
        {"pattern": "(?i)guava", "labels": {"produce": "guava"}},
        {"pattern": "(?i)lime", "labels": {"produce": "lime"}},
        {"pattern": "(?i)orange", "labels": {"produce": "orange"}},
        {"pattern": "(?i)pomegranate", "labels": {"produce": "pomegranate"}},
        {"pattern": "(?i)(_good|good[ _]quality)", "labels": {"freshness": "fresh"}},
        {"pattern": "(?i)(_bad|bad[ _]quality)", "labels": {"freshness": ["declining", "spoiled"]}}
      ]
    },
    "hass_avocado_ripening": {
      "adapter": "table",
      "verified_against_download": false,
      "table": "metadata.csv",
      "path_column": "filename",
      "group_column": "sample",
      "constant_labels":           {"produce": "avocado"},
      "columns":                   {"ripeness": "ripening_index"},
      "value_maps":                {"ripeness": {"1": "unripe", "2": "partially_ripe", "3": "ripe", "4": "ripe", "5": "overripe"}}
    },
    "strawberry_avocado_ripening": {
      "adapter": "path_rules",
      "verified_against_download": false,
      "rules": [
        {"pattern": "(?i)strawberr", "labels": {"produce": "strawberry"}},
        {"pattern": "(?i)avocado", "labels": {"produce": "avocado"}},
        {"pattern": "(?i)rotten", "labels": {"freshness": "spoiled", "visual_spoilage": ["mild", "severe"]}},
        {"pattern": "(?i)unripe", "labels": {"ripeness": "unripe"}},
        {"pattern": "(?i)partial", "labels": {"ripeness": "partially_ripe"}},
        {"pattern": "(?i)(^|/|_| )ripe", "labels": {"ripeness": "ripe"}}
      ]
    },
    "fruits360_original": {
      "adapter": "path_rules",
      "verified_against_download": true,
      "verified_note": "Checked 2026-09-26 against 151 real class dirs (Training/Validation/Test/<Class N>/rK_N.jpg). This version has 'Avocado Black'/'Avocado Green' (NOT mapped to ripeness: skin colour depends on cultivar), 'Orange peeled' (excluded), no mandarin/kiwi/mango/watermelon/persimmon classes.",
      "default_produce": "other",
      "exclude_patterns": ["(?i)wedge", "(?i)(^|/)[^/]*\\bcut\\b", "(?i)peeled"],
      "max_per_group": 80,
      "group_pattern": "(?P<group>[^/]+)/[^/]+$",
      "force_split": "train",
      "rules": [
        {"pattern": "(?i)(^|/)Avocado ripe", "labels": {"produce": "avocado", "ripeness": "ripe"}},
        {"pattern": "(?i)(^|/)Tomato not Ripen", "labels": {"produce": "tomato", "ripeness": "unripe"}},
        {"pattern": "(?i)(^|/)Watermelon", "labels": {"produce": "watermelon"}},
        {"pattern": "(?i)(^|/)(Melon|Cantaloupe)", "labels": {"produce": "melon"}},
        {"pattern": "(?i)(^|/)Apple", "labels": {"produce": "apple"}},
        {"pattern": "(?i)(^|/)Avocado", "labels": {"produce": "avocado"}},
        {"pattern": "(?i)(^|/)Banana", "labels": {"produce": "banana"}},
        {"pattern": "(?i)(^|/)Cucumber", "labels": {"produce": "cucumber"}},
        {"pattern": "(?i)(^|/)Grape(?!fruit)", "labels": {"produce": "grape"}},
        {"pattern": "(?i)(^|/)(Kaki|Persimmon)", "labels": {"produce": "persimmon"}},
        {"pattern": "(?i)(^|/)Kiwi", "labels": {"produce": "kiwi"}},
        {"pattern": "(?i)(^|/)Lemon", "labels": {"produce": "lemon"}},
        {"pattern": "(?i)(^|/)(Mandarin|Clementine|Tangelo)", "labels": {"produce": "mandarin"}},
        {"pattern": "(?i)(^|/)Mango", "labels": {"produce": "mango"}},
        {"pattern": "(?i)(^|/)Nectarine", "labels": {"produce": "nectarine"}},
        {"pattern": "(?i)(^|/)Orange", "labels": {"produce": "orange"}},
        {"pattern": "(?i)(^|/)Peach", "labels": {"produce": "peach"}},
        {"pattern": "(?i)(^|/)Pear", "labels": {"produce": "pear"}},
        {"pattern": "(?i)(^|/)Pepper", "labels": {"produce": "pepper"}},
        {"pattern": "(?i)(^|/)Plum", "labels": {"produce": "plum"}},
        {"pattern": "(?i)(^|/)Pomegranate", "labels": {"produce": "pomegranate"}},
        {"pattern": "(?i)(^|/)Strawberry", "labels": {"produce": "strawberry"}},
        {"pattern": "(?i)(^|/)Tomato", "labels": {"produce": "tomato"}},
        {"pattern": "(?i)(^|/)Guava", "labels": {"produce": "guava"}}
      ]
    },
    "fruq_db": {
      "adapter": "path_rules",
      "verified_against_download": false,
      "rules": [
        {"pattern": "(?i)banana", "labels": {"produce": "banana"}},
        {"pattern": "(?i)cucumber", "labels": {"produce": "cucumber"}},
        {"pattern": "(?i)grape", "labels": {"produce": "grape"}},
        {"pattern": "(?i)kaki", "labels": {"produce": "persimmon"}},
        {"pattern": "(?i)papaya", "labels": {"produce": "other"}},
        {"pattern": "(?i)peach", "labels": {"produce": "peach"}},
        {"pattern": "(?i)pear", "labels": {"produce": "pear"}},
        {"pattern": "(?i)pepper", "labels": {"produce": "pepper"}},
        {"pattern": "(?i)strawberr", "labels": {"produce": "strawberry"}},
        {"pattern": "(?i)tomato", "labels": {"produce": "tomato"}},
        {"pattern": "(?i)watermelon", "labels": {"produce": "watermelon"}},
        {"pattern": "(?i)good", "labels": {"freshness": "fresh"}},
        {"pattern": "(?i)mild", "labels": {"freshness": "declining"}},
        {"pattern": "(?i)rotten", "labels": {"freshness": "spoiled", "visual_spoilage": ["mild", "severe"]}}
      ]
    },
    "open_images_v7": {
      "adapter": "table",
      "verified_against_download": true,
      "verified_note": "Class display names checked against oidv7-class-descriptions-boxable.csv on 2026-09-26. 'Lemon (plant)' and 'Orange (fruit)' are the real names.",
      "table": "crops.csv",
      "path_column": "path",
      "group_column": "image_id",
      "split_column": "split",
      "columns":                   {"produce": "class_name"},
      "value_maps": {
        "produce": {
          "Apple": "apple",
          "Banana": "banana",
          "Orange (fruit)": "orange",
          "Tomato": "tomato",
          "Strawberry": "strawberry",
          "Grape": "grape",
          "Pear": "pear",
          "Peach": "peach",
          "Mango": "mango",
          "Pomegranate": "pomegranate",
