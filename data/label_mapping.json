    "fruitnet_indian": {
      "adapter": "path_rules",
      "verified_against_download": true,
      "exclude_patterns": [
        "(?i)mixed"
      ],
      "rules": [
        {
          "pattern": "(?i)apple",
          "labels": {
            "produce": "apple"
          }
        },
        {
          "pattern": "(?i)banana",
          "labels": {
            "produce": "banana"
          }
        },
        {
          "pattern": "(?i)guava",
          "labels": {
            "produce": "guava"
          }
        },
        {
          "pattern": "(?i)lime",
          "labels": {
            "produce": "lime"
          }
        },
        {
          "pattern": "(?i)orange",
          "labels": {
            "produce": "orange"
          }
        },
        {
          "pattern": "(?i)pomegranate",
          "labels": {
            "produce": "pomegranate"
          }
        },
        {
          "pattern": "(?i)(_good|good[ _]quality)",
          "labels": {
            "freshness": "fresh",
            "visual_spoilage": "none"
          }
        },
        {
          "pattern": "(?i)banana_bad",
          "labels": {
            "freshness": "unknown",
            "visual_spoilage": "unknown"
          }
        },
        {
          "pattern": "(?i)(_bad|bad[ _]quality)",
          "labels": {
            "freshness": [
              "declining",
              "spoiled"
            ],
            "visual_spoilage": [
              "mild",
              "severe"
            ]
          }
        }
      ],
      "verified_note": "Layout checked 2026-09-27 (b6fftwbr2v-3/FruitNetDataset/{Good Quality_Fruits,Bad Quality_Fruits,Mixed Qualit_Fruits}/<Fruit>_<Good|Bad>/). Visual audit of 36 random Bad photos: mostly rot/mould, some single bruises or spots, speckled overripe bananas -> set-valued labels, banana Bad unlabelled. Mixed (several fruits per image) excluded."
    },
    "hass_avocado_ripening": {
      "adapter": "table",
      "verified_against_download": true,
      "table": "metadata.csv",
      "path_column": "filename",
      "group_column": "sample",
      "constant_labels": {
        "produce": "avocado"
      },
      "columns": {
        "ripeness": "ripening_index"
      },
      "value_maps": {
        "ripeness": {
          "1": "unripe",
          "2": "partially_ripe",
          "3": "ripe",
          "4": "ripe",
          "5": "overripe"
        }
      },
      "verified_note": "Downloaded 2026-09-27 via scripts/fetch_mendeley.py (--zip); metadata.csv from the authors' xlsx by scripts/prepare_hass_avocado.py",
      "cultivar": "hass",
      "split_by_metadata_group": true
    },
    "strawberry_avocado_ripening": {
      "adapter": "path_rules",
      "verified_against_download": true,
      "verified_note": "Mendeley zysvgmxcyz v1 (CC BY 4.0, authors' own photos). Class order from the paper (PMC12152553): 0-3 strawberry unripe/partially/ripe/rotten, 4-7 avocado same order. scripts/prepare_strawberry_avocado.py sorts single-class images into sorted/<class>/. Contains background-replaced copies and the same fruits over 25 days, so it is TRAIN ONLY (never val/test). Avocado cultivars are mixed -> no avocado ripeness labels; used for freshness/defects and identification.",
      "force_split": "train",
      "rules": [
        {
          "pattern": "(^|/)sorted/strawberry_",
          "labels": {
            "produce": "strawberry"
          }
        },
        {
          "pattern": "(^|/)sorted/avocado_",
          "labels": {
            "produce": "avocado"
          }
        },
        {
          "pattern": "(^|/)sorted/strawberry_unripe/",
          "labels": {
            "ripeness": "unripe"
          }
        },
        {
          "pattern": "(^|/)sorted/strawberry_partially_ripe/",
          "labels": {
            "ripeness": "partially_ripe"
          }
        },
        {
          "pattern": "(^|/)sorted/strawberry_ripe/",
          "labels": {
            "ripeness": "ripe"
          }
        },
        {
          "pattern": "(^|/)sorted/[a-z]+_(unripe|partially_ripe|ripe)/",
          "labels": {
            "freshness": "fresh",
            "visual_spoilage": "none"
          }
        },
        {
          "pattern": "(^|/)sorted/[a-z]+_rotten/",
          "labels": {
            "freshness": "spoiled",
            "visual_spoilage": [
              "mild",
              "severe"
            ]
          }
        }
      ],
      "exclude_patterns": [
        "^images/",
        "^labels/"
      ]
    },
    "fruits360_original": {
      "adapter": "path_rules",
      "verified_against_download": true,
      "verified_note": "Checked 2026-09-26 against 151 real class dirs (Training/Validation/Test/<Class N>/rK_N.jpg). This version has 'Avocado Black'/'Avocado Green' (NOT mapped to ripeness: skin colour depends on cultivar), 'Orange peeled' (excluded), no mandarin/kiwi/mango/watermelon/persimmon classes.",
      "default_produce": "other",
      "exclude_patterns": [
        "(?i)wedge",
        "(?i)(^|/)[^/]*\\bcut\\b",
        "(?i)peeled"
      ],
      "max_per_group": 80,
      "group_pattern": "(?P<group>[^/]+)/[^/]+$",
      "force_split": "train",
      "rules": [
        {
          "pattern": "(?i)(^|/)Avocado ripe",
          "labels": {
            "produce": "avocado",
            "ripeness": "ripe"
          }
        },
        {
          "pattern": "(?i)(^|/)Tomato not Ripen",
          "labels": {
            "produce": "tomato",
            "ripeness": "unripe"
          }
        },
        {
          "pattern": "(?i)(^|/)Watermelon",
          "labels": {
            "produce": "watermelon"
          }
        },
        {
          "pattern": "(?i)(^|/)(Melon|Cantaloupe)",
          "labels": {
            "produce": "melon"
          }
        },
        {
          "pattern": "(?i)(^|/)Apple",
          "labels": {
            "produce": "apple"
          }
        },
        {
          "pattern": "(?i)(^|/)Avocado",
          "labels": {
            "produce": "avocado"
          }
        },
        {
          "pattern": "(?i)(^|/)Banana",
          "labels": {
            "produce": "banana"
          }
        },
        {
          "pattern": "(?i)(^|/)Cucumber",
          "labels": {
            "produce": "cucumber"
          }
        },
        {
